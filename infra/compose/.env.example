# infra/compose/.env.example —— 部署清单模板
#
# 首次使用请复制为 .env：cp .env.example .env
# compose.yaml 里所有 `${VAR:?...}` 的变量都是必填，缺失会直接在启动时报错，
# 而不是带着空密码把服务拉起来（那样 chat 会在连接数据库时才失败，排查成本高）。
#
# 本文件只放占位值。不要把真实的 .env 提交进版本库 —— .dockerignore 已经排除
# 了 **/.env*，但 compose 读取的是宿主机上的文件，仓库层面同样不能入库。

# ── PostgreSQL（pgvector/pgvector:pg16）──
POSTGRES_USER=postgres
# 生产请用强随机值：openssl rand -hex 16
POSTGRES_PASSWORD=change-me
POSTGRES_DB=autix_chat
# 第二十章 20.8：user-system 用的库。POSTGRES_DB 只能建一个库，
# autix_rbac 由 postgres-init/01-create-rbac-database.sql 补建（只在数据卷为空时执行）。
# 不填就用默认值 autix_rbac。
RBAC_DB=autix_rbac

# ── chat 服务 ──
# 必须与 user-system 使用的 JWT 密钥一致，否则 chat 无法验签 user-system 签发的令牌。
# 长度需 ≥ 32 字符，低于此长度 getJwtSecret() 会直接抛错（第 18 章加固）。
# 生成：openssl rand -hex 32
JWT_SECRET=change-me-to-a-random-string-at-least-32-chars

# ── 模型 ──
# 留空则走库里配置的模型（model-config），适合只想先把服务拉起来的场景
OPENAI_API_KEY=
OPENAI_BASE_URL=

# ── 第十七章评测（可选）──
# ragas 服务本身不需要额外变量；跑 run-eval.ts 时才需要上面的 OPENAI_API_KEY
