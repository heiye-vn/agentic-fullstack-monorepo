{
  "name": "autix-monorepo",
  "version": "0.0.1",
  "private": true,
  "packageManager": "pnpm@10.12.1",
  "scripts": {
    "dev": "turbo dev",
    "dev:chat-web": "pnpm --filter @autix/chat-web dev",
    "dev:chat": "pnpm --filter @autix/chat dev",
    "dev:user-system": "pnpm --filter @autix/user-system dev",
    "dev:admin-web": "pnpm --filter @autix/admin-web dev",
    "dev:rbac": "turbo run dev --filter=@autix/user-system --filter=@autix/admin-web",
    "build": "turbo build",
    "typecheck": "turbo typecheck",
    "postinstall": "pnpm --filter @autix/user-system prisma:generate"
  },
  "devDependencies": {
    "@types/node": "^22.13.5",
    "turbo": "^2.4.4",
    "typescript": "^5.7.3"
  }
}
