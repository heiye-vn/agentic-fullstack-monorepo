# ==========================================
# Admin Web 前端环境变量配置模板
# 复制本文件为 .env.local 并按需填写: cp .env.example .env.local
# ==========================================
# 命名与 chat-web 保持一致：
#   NEXT_PUBLIC_USER_API_URL  -> user-system 服务 (4002)
#   NEXT_PUBLIC_CHAT_API_URL  -> chat 服务      (4001)
# ==========================================

# 后端服务 API 地址 (user-system)
NEXT_PUBLIC_USER_API_URL="http://localhost:4002/api/v1"

# 前端开发端口
PORT=3100
