{
  "$schema": "https://json.schemastore.org/nest-cli",
  "collection": "@nestjs/schematics",
  "sourceRoot": "src",
  "entryFile": "main.js",
  "compilerOptions": {
    "deleteOutDir": true,
    "assets": [
      {
        "include": "skills/definitions/**/*.md",
        "watchAssets": true
      },
      {
        "include": "eval/rubrics/**/*.yaml",
        "watchAssets": true
      },
      {
        "include": "eval/datasets/**/*.jsonl",
        "watchAssets": true
      },
      {
        "include": "eval/corpus/**/*.jsonl",
        "watchAssets": true
      }
    ]
  }
}
