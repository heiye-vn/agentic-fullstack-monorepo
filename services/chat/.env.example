# ==========================================
# Chat 微服务环境变量配置模板
# 复制本文件为 .env 并按需填写实际参数: cp .env.example .env
# ==========================================

# 服务运行端口
# 原默认 4001 端口易与 Windows 桌面软件（如腾讯 QQNT 内部服务 127.0.0.1:4001）发生端口独占冲突，
# 导致前端 HTTP/SSE 请求被直接拦截切断报错 "TypeError: Failed to fetch"。因此统一调整为 4005。
PORT=4005

# === LLM 大模型服务 (兼容 OpenAI 规范，支持阿里云百炼/OpenAI/DeepSeek 等) ===
OPENAI_API_KEY=sk-your-api-key-here
OPENAI_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1

# === Embedding 向量服务 (可选，留空则默认复用 OPENAI_API_KEY) ===
EMBEDDING_API_KEY=

# === 独立向量数据库 (可选，若使用外部 Qdrant 等) ===
VECTOR_DB_URL=http://localhost:6333
VECTOR_DB_API_KEY=your-vector-db-api-key

# === PostgreSQL 关系与向量数据库 (Prisma 驱动，需启用 pgvector 扩展) ===
DATABASE_URL="postgresql://postgres:postgres123@localhost:5432/autix_chat?schema=public"
# DATABASE_URL="postgresql://postgres:postgres123@localhost:5432/autix_chat_demo?schema=public"

# === JWT 统一鉴权密钥 (需与 user-system 保持一致) ===
JWT_SECRET="autix_rbac_jwt_secret_key_2026_super_secure"

# === 模型配置密钥的落库加密密钥 (AES-256-GCM) ===
# 用于加密 model_configs.apiKey。未设置时回退用 JWT_SECRET。
# 警告：改了这个值，之前入库的私有模型密钥将无法解密（会静默回退到 OPENAI_API_KEY），
#       需要重新在页面上填写一次。
MODEL_CONFIG_SECRET=

# === 存储目录配置 (可选) ===
# UPLOAD_DIR="./uploads"
# CHAT_WORKSPACE_DIR="./workspace"

# === 第十二章 MCP（Model Context Protocol）===
# 总开关。关闭时专家 Agent 只用第九章的本地工具，行为完全不变。
MCP_ENABLED=false

# 传输方式：memory（默认，进程内直连，零子进程）| stdio（真实子进程隔离）
# MCP_STDIO=true
# stdio 模式下可覆盖启动命令（默认是 node dist/mcp-servers/<name>/src/index.js）
# MCP_STDIO_COMMAND=node
# MCP_STDIO_ARGS=dist/mcp-servers/requirement-analyzer/src/index.js

# web-search Server 的搜索 API。留空则进入 mock 模式（返回预置语料，链路仍可跑通）
TAVILY_API_KEY=

# === 第十三章 Skills ===
# 总开关。Skills 是纯本地资产（读 src/skills/definitions/*/SKILL.md + 调本地确定性工具），
# 无外部依赖、无额外模型成本，所以默认开启；置为 false 则回到第十二章的行为。
SKILLS_ENABLED=true

# Skill 资产目录（一般不用改）。默认依次尝试 dist/skills/definitions 与 src/skills/definitions
# SKILLS_DIR=

# 单个 Skill 正文的字符上限，超出截断，防止一份资产吃掉整轮上下文
# SKILLS_MAX_CONTENT_CHARS=20000
