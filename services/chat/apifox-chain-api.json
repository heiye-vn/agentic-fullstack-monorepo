{
  "openapi": "3.0.1",
  "info": {
    "title": "LangChain LCEL 需求抽取链 API (Chat Service)",
    "description": "基于 LangChain LCEL requirementPrompt.pipe(model).pipe(new StringOutputParser()) 构建的最小调用链测试接口集合，可直接导入 Apifox 进行联调与自动化测试。",
    "version": "1.0.0"
  },
  "servers": [
    {
      "url": "http://localhost:4001",
      "description": "本地开发环境"
    }
  ],
  "paths": {
    "/api/langchain/chain-invoke": {
      "post": {
        "summary": "LCEL 链单次调用 (chain-invoke)",
        "description": "单次调用 requirementChain，通过 StringOutputParser 直接返回解析后的字符串结果。输入为空时统一兜底为：'用户注册时必须绑定手机号，密码至少8位'。",
        "operationId": "chainInvoke",
        "requestBody": {
          "required": false,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/InvokeDto"
              },
              "example": {
                "input": "用户注册时必须绑定手机号，密码至少8位"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "调用成功",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ChainInvokeResult"
                },
                "example": {
                  "content": "{\n  \"action\": \"用户注册\",\n  \"constraints\": [\n    \"必须绑定手机号\",\n    \"密码至少8位\"\n  ],\n  \"entities\": [\n    \"用户\",\n    \"手机号\",\n    \"密码\"\n  ]\n}"
                }
              }
            }
          }
        }
      }
    },
    "/api/langchain/chain-stream": {
      "post": {
        "summary": "LCEL 链流式调用 (chain-stream)",
        "description": "流式逐 chunk 输出文本流 (text/plain; charset=utf-8)。输入为空时统一兜底为：'用户注册时必须绑定手机号，密码至少8位'。",
        "operationId": "chainStream",
        "requestBody": {
          "required": false,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/InvokeDto"
              },
              "example": {
                "input": "用户注册时必须绑定手机号，密码至少8位"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "文本流式输出",
            "content": {
              "text/plain": {
                "schema": {
                  "type": "string"
                },
                "example": "{\n  \"action\": \"用户注册\"..."
              }
            }
          }
        }
      }
    },
    "/api/langchain/chain-batch": {
      "post": {
        "summary": "LCEL 链批量并发调用 (chain-batch)",
        "description": "批量并发执行 requirementChain。未传 inputs 时统一默认包含：'用户注册时必须绑定手机号，密码至少8位'。",
        "operationId": "chainBatch",
        "requestBody": {
          "required": false,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/BatchDto"
              },
              "example": {
                "inputs": [
                  "用户注册时必须绑定手机号，密码至少8位",
                  "商品下单时必须选择收货地址，优惠券最多使用1张"
                ]
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "批量执行结果",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ChainBatchResult"
                },
                "example": {
                  "results": [
                    "{\n  \"action\": \"用户注册\",\n  \"constraints\": [\"必须绑定手机号\", \"密码至少8位\"],\n  \"entities\": [\"用户\", \"手机号\", \"密码\"]\n}",
                    "{\n  \"action\": \"商品下单\",\n  \"constraints\": [\"必须选择收货地址\", \"最多使用1张\"],\n  \"entities\": [\"商品\", \"收货地址\", \"优惠券\"]\n}"
                  ],
                  "totalDurationMs": 1520
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "InvokeDto": {
        "type": "object",
        "properties": {
          "input": {
            "type": "string",
            "description": "用户输入需求文本，为空时兜底为：'用户注册时必须绑定手机号，密码至少8位'",
            "example": "用户注册时必须绑定手机号，密码至少8位"
          }
        }
      },
      "BatchDto": {
        "type": "object",
        "properties": {
          "inputs": {
            "type": "array",
            "description": "批量输入需求文本列表，为空时默认使用包含单条默认需求的数组",
            "items": {
              "type": "string"
            },
            "example": [
              "用户注册时必须绑定手机号，密码至少8位"
            ]
          }
        }
      },
      "ChainInvokeResult": {
        "type": "object",
        "required": ["content"],
        "properties": {
          "content": {
            "type": "string",
            "description": "经 StringOutputParser 转换后的模型输出纯文本内容"
          }
        }
      },
      "ChainBatchResult": {
        "type": "object",
        "required": ["results", "totalDurationMs"],
        "properties": {
          "results": {
            "type": "array",
            "description": "批量抽取的纯文本结果列表",
            "items": {
              "type": "string"
            }
          },
          "totalDurationMs": {
            "type": "number",
            "description": "批量处理总耗时（毫秒）"
          }
        }
      }
    }
  }
}
