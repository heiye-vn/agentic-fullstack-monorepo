generator client {
  provider        = "prisma-client"
  output          = "../src/generated/prisma"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  extensions = [vector]
}

// 消息角色枚举
enum MessageRole {
  USER
  ASSISTANT
}

// 任务状态枚举
enum TaskStatus {
  pending
  processing
  done
  error
}

// 产物类型枚举
enum ArtifactType {
  MARKDOWN
  CODE
  DOCUMENT
  TABLE
  CHART
}

// 模型类型枚举
enum ModelType {
  general
  code
  intent
  embedding
}

// 模型可见性枚举
enum ModelVisibility {
  public
  private
}

// 1. 会话表
model Conversation {
  id        String    @id @default(cuid())
  userId    String    // 关联用户系统 User ID (不建外键约束)
  title     String
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  messages  Message[]
  artifact  Artifact?

  @@index([userId])
  @@map("conversations")
}

// 2. 消息表
model Message {
  id             String       @id @default(cuid())
  conversationId String
  role           MessageRole
  content        String       @db.Text
  metadata       Json?
  createdAt      DateTime     @default(now())

  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  artifactVersions ArtifactVersion[]

  @@index([conversationId])
  @@map("messages")
}

// 3. 文档表
model Document {
  id          String          @id @default(cuid())
  userId      String          // 关联用户系统 User ID (不建外键约束)
  filename    String
  mimeType    String
  size        Int
  filePath    String?
  storageType String          @default("local")
  status      String          @default("pending")
  chunkCount  Int             @default(0)
  createdAt   DateTime        @default(now())

  chunks      DocumentChunk[]

  @@index([userId])
  @@map("documents")
}

// 4. 文档切片与向量表
model DocumentChunk {
  id         String                 @id @default(cuid())
  documentId String
  content    String                 @db.Text
  chunkIndex Int
  embedding  Unsupported("vector")?

  document   Document               @relation(fields: [documentId], references: [id], onDelete: Cascade)

  @@index([documentId])
  @@map("document_chunks")
}

// 5. 任务事件表
model TaskEvent {
  id        String     @id @default(cuid())
  userId    String     // 关联用户系统 User ID (不建外键约束)
  taskType  String
  taskId    String
  status    TaskStatus @default(pending)
  message   String?    @db.Text
  metadata  Json?
  createdAt DateTime   @default(now())
  readAt    DateTime?

  @@index([userId])
  @@index([taskId])
  @@map("task_events")
}

// 6. 产物表（一个会话最多一个产物）
model Artifact {
  id             String       @id @default(cuid())
  conversationId String       @unique
  userId         String       // 关联用户系统 User ID (不建外键约束)
  title          String
  type           ArtifactType @default(MARKDOWN)
  language       String?
  content        String       @db.Text
  currentVersion Int          @default(1)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  versions       ArtifactVersion[]

  @@index([userId])
  @@map("artifacts")
}

// 7. 产物版本表（每次修改追加一版，可回溯/回滚）
model ArtifactVersion {
  id              String   @id @default(cuid())
  artifactId      String
  version         Int
  content         String   @db.Text
  changelog       String?
  sourcetags      String[] // AI / HUMAN 等来源标记
  sourceMessageId String?
  createdAt       DateTime @default(now())

  artifact        Artifact @relation(fields: [artifactId], references: [id], onDelete: Cascade)
  sourceMessage   Message? @relation(fields: [sourceMessageId], references: [id])

  @@unique([artifactId, version])
  @@index([artifactId, createdAt])
  @@map("artifact_versions")
}

// 8. 模型配置表（前端模型选择器 + 后台管理）
model ModelConfig {
  id           String          @id @default(cuid())
  name         String          @db.VarChar(100)
  provider     String          @default("openai") @db.VarChar(50)
  model        String          @db.VarChar(100)
  type         ModelType       @default(general)
  priority     Int             @default(0)
  baseUrl      String?         @db.VarChar(200)
  apiKey       String?         @db.VarChar(200)
  metadata     Json?
  isActive     Boolean         @default(true)
  isDefault    Boolean         @default(false)
  visibility   ModelVisibility @default(public)
  createdBy    String?         @db.VarChar(50)
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt
  capabilities String[]        @default(["text"])

  @@index([createdBy])
  @@index([isActive])
  @@index([isDefault])
  @@index([type])
  @@index([visibility])
  @@map("model_configs")
}

// 9. Token 消耗与成本明细表（节点级）
model TokenUsage {
  id                String   @id @default(cuid())
  conversationId    String?  @db.VarChar(255)
  messageId         String?  @db.VarChar(255)
  threadId          String?  @db.VarChar(255)
  graphName         String   @db.VarChar(100)
  nodeName          String   @db.VarChar(100)
  agentName         String   @db.VarChar(100)
  modelConfigId     String?  @db.VarChar(255)
  modelName         String   @db.VarChar(100)
  provider          String   @default("openai") @db.VarChar(50)
  inputTokens       Int      @default(0)
  outputTokens      Int      @default(0)
  totalTokens       Int      @default(0)
  cachedInputTokens Int      @default(0)
  estimatedCostUsd  Float    @default(0)
  isEstimated       Boolean  @default(false)
  latencyMs         Int      @default(0)
  overrideReason    String?
  createdAt         DateTime @default(now())

  @@index([conversationId])
  @@index([graphName, nodeName])
  @@index([agentName])
  @@index([modelConfigId])
  @@index([createdAt])
  @@map("token_usages")
}

