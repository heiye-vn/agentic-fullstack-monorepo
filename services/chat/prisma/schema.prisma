generator client {
  provider        = "prisma-client"
  output          = "../src/generated/prisma"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  extensions = [vector]
}

// 消息角色枚举
enum MessageRole {
  USER
  ASSISTANT
}

// 任务状态枚举
enum TaskStatus {
  pending
  processing
  done
  error
}

// 产物类型枚举
enum ArtifactType {
  MARKDOWN
  CODE
  DOCUMENT
  TABLE
  CHART
}

// 模型类型枚举
enum ModelType {
  general
  code
  intent
  embedding
}

// 模型可见性枚举
enum ModelVisibility {
  public
  private
}

// 1. 会话表
model Conversation {
  id        String    @id @default(cuid())
  userId    String    // 关联用户系统 User ID (不建外键约束)
  title     String
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  messages  Message[]
  artifact  Artifact?

  @@index([userId])
  @@map("conversations")
}

// 2. 消息表
model Message {
  id             String       @id @default(cuid())
  conversationId String
  role           MessageRole
  content        String       @db.Text
  metadata       Json?
  createdAt      DateTime     @default(now())

  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  artifactVersions ArtifactVersion[]

  @@index([conversationId])
  @@map("messages")
}

// 3. 文档表
model Document {
  id          String          @id @default(cuid())
  userId      String          // 关联用户系统 User ID (不建外键约束)
  filename    String
  mimeType    String
  size        Int
  filePath    String?
  storageType String          @default("local")
  status      String          @default("pending")
  chunkCount  Int             @default(0)
  createdAt   DateTime        @default(now())

  chunks      DocumentChunk[]

  @@index([userId])
  @@map("documents")
}

// 4. 文档切片与向量表
model DocumentChunk {
  id         String                 @id @default(cuid())
  documentId String
  content    String                 @db.Text
  chunkIndex Int
  embedding  Unsupported("vector")?

  /**
   * 生成该向量的 Embedding 模型名（教程 11.3.7）
   *
   * 必须存，因为"入库用模型 A、查询用模型 B"会让检索结果变成纯噪音，
   * 而这类事故在现象上只是"召回变差"，极难排查（见 11.12 FAQ Q4）。
   * 默认值取历史数据实际使用的模型：既保证存量行有值（NOT NULL 不迁移失败），
   * 又让后续换模型时能靠 expectedModelName 校验一把拦住。
   */
  modelName  String                 @default("Xenova/paraphrase-multilingual-MiniLM-L12-v2") @db.VarChar(128)

  document   Document               @relation(fields: [documentId], references: [id], onDelete: Cascade)

  @@index([documentId])
  @@index([modelName])
  @@map("document_chunks")
}

// 5. 任务事件表
model TaskEvent {
  id        String     @id @default(cuid())
  userId    String     // 关联用户系统 User ID (不建外键约束)
  taskType  String
  taskId    String
  status    TaskStatus @default(pending)
  message   String?    @db.Text
  metadata  Json?
  createdAt DateTime   @default(now())
  readAt    DateTime?

  @@index([userId])
  @@index([taskId])
  @@map("task_events")
}

// 6. 产物表（一个会话最多一个产物）
model Artifact {
  id             String       @id @default(cuid())
  conversationId String       @unique
  userId         String       // 关联用户系统 User ID (不建外键约束)
  title          String
  type           ArtifactType @default(MARKDOWN)
  language       String?
  content        String       @db.Text
  currentVersion Int          @default(1)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  versions       ArtifactVersion[]

  @@index([userId])
  @@map("artifacts")
}

// 7. 产物版本表（每次修改追加一版，可回溯/回滚）
model ArtifactVersion {
  id              String   @id @default(cuid())
  artifactId      String
  version         Int
  content         String   @db.Text
  changelog       String?
  sourcetags      String[] // AI / HUMAN 等来源标记
  sourceMessageId String?
  createdAt       DateTime @default(now())

  artifact        Artifact @relation(fields: [artifactId], references: [id], onDelete: Cascade)
  sourceMessage   Message? @relation(fields: [sourceMessageId], references: [id])

  @@unique([artifactId, version])
  @@index([artifactId, createdAt])
  @@map("artifact_versions")
}

// 8. 模型配置表（前端模型选择器 + 后台管理）
model ModelConfig {
  id           String          @id @default(cuid())
  name         String          @db.VarChar(100)
  provider     String          @default("openai") @db.VarChar(50)
  model        String          @db.VarChar(100)
  type         ModelType       @default(general)
  priority     Int             @default(0)
  baseUrl      String?         @db.VarChar(200)
  apiKey       String?         @db.VarChar(200)
  metadata     Json?
  isActive     Boolean         @default(true)
  isDefault    Boolean         @default(false)
  visibility   ModelVisibility @default(public)
  createdBy    String?         @db.VarChar(50)
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt
  capabilities String[]        @default(["text"])

  @@index([createdBy])
  @@index([isActive])
  @@index([isDefault])
  @@index([type])
  @@index([visibility])
  @@map("model_configs")
}

// 9. Token 消耗与成本明细表（节点级）
model TokenUsage {
  id                String   @id @default(cuid())
  conversationId    String?  @db.VarChar(255)
  messageId         String?  @db.VarChar(255)
  threadId          String?  @db.VarChar(255)
  graphName         String   @db.VarChar(100)
  nodeName          String   @db.VarChar(100)
  agentName         String   @db.VarChar(100)
  modelConfigId     String?  @db.VarChar(255)
  modelName         String   @db.VarChar(100)
  provider          String   @default("openai") @db.VarChar(50)
  inputTokens       Int      @default(0)
  outputTokens      Int      @default(0)
  totalTokens       Int      @default(0)
  cachedInputTokens Int      @default(0)
  estimatedCostUsd  Float    @default(0)
  isEstimated       Boolean  @default(false)
  latencyMs         Int      @default(0)
  overrideReason    String?
  createdAt         DateTime @default(now())

  @@index([conversationId])
  @@index([graphName, nodeName])
  @@index([agentName])
  @@index([modelConfigId])
  @@index([createdAt])
  @@map("token_usages")
}

// 10. 评测流水线运行快照表（第十七章 17.7）
//     每次跑 run-eval.ts 落一行：既存档指标，也把当时的 rubric 版本、
//     judge 模型、git SHA 一起记下来。缺了这些上下文，三个月后看到
//     「recall 从 0.92 掉到 0.81」根本无从判断是 RAG 退化了还是换了 embedding。
model EvalRun {
  id            String   @id @default(cuid())
  createdAt     DateTime @default(now())
  /** 评测的数据集名（eval/datasets 下的文件名） */
  datasetName   String   @db.VarChar(100)
  /** 被测代码版本，由 GIT_SHA 环境变量或 git rev-parse 取得 */
  gitSha        String?  @db.VarChar(64)
  /** judge 用的模型名；--no-llm 模式写 "none(--no-llm)"，不要留空 */
  judgeModel    String   @db.VarChar(100)
  /** 本次使用的 rubric 版本号，用于解释历史分数为什么不可直接横向比较 */
  rubricVersion Int?
  /** 是否只跑了检索指标（未过图、未调 judge） */
  noLlm         Boolean  @default(false)
  totalCases    Int
  /** 执行失败的 case 数；> 0 时整轮门禁直接 fail */
  failedCases   Int      @default(0)
  passed        Boolean
  /** 未通过门禁的具体原因（中文短句），通过时为空数组 */
  gateReasons   String[] @default([])
  avgRecall        Float?
  avgPrecision     Float?
  avgNdcg          Float?
  avgMrr           Float?
  avgJudgeScore    Float?
  avgIntentCorrect Float?
  avgFaithfulness  Float?
  /** 完整报告快照（分桶 + 逐 case 指标），字段够大时用 Json 比拆表划算 */
  report        Json

  @@index([createdAt])
  @@index([datasetName, passed])
  @@map("eval_runs")
}

